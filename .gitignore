.idea
__pycache__/

# generated FHIR package caches
.index.db

# Windows counterparts of the IG publisher scripts, pulled in by _updatePublisher.sh
_*.bat

# local outputs of the ICD data migration (demo runs)
/transformed_data/

# terminology-mapping: raw ICD source data (download separately, see
# scripts/terminology-mapping/README.md). Whole tree — one folder per code
# system per year, several hundred MB.
scripts/terminology-mapping/sources/
# large generated CodeSystems are published as GitHub release assets, not committed
scripts/terminology-mapping/output/CodeSystem-*.json
# derived view of mapping-statistics.csv (which IS committed) — regenerate any time
# scripts/terminology-mapping/output/mapping-statistics.html

# merged-profile-provisioning: local Spark scratch + generated draft artifacts
# (document mode's summaries/suggested FSH are drafts for a human to review,
# not files consumed by the IG build)
scripts/merged_profile_provisioning/spark-warehouse/
scripts/merged_profile_provisioning/artifacts/

# binding-analysis: the full-data distinct-code extraction, 9.4 MB of
# warehouse-derived counts. Regenerate with phase1_extract_distinct.py on the
# node; what it was reduced to is committed as binding-report.{json,md},
# work-items.json and FINDINGS.md.
scripts/binding-analysis/distinct-codes.ndjson

# Local credentials and Pi agent/session artifacts — never commit
.env
.pi/

# terminology-mapping: full-MIMIC-IV lookup tables with small cells (counts
# below 11, free-text displays and values). Local only, never tracked; see
# occurrences/README.md and valueshapes/README.md for how to regenerate them.
scripts/terminology-mapping/occurrences/code-occurrences.csv
scripts/terminology-mapping/occurrences/reference-occurrences.csv
scripts/terminology-mapping/occurrences/prod/inventory/
scripts/terminology-mapping/occurrences/unit-output/unit-occurrences.csv
scripts/terminology-mapping/valueshapes/observation-value-shapes.csv
