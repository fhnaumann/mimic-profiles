# Pipeline configuration — copy to .env and adjust. Scripts read these as
# defaults; their CLI flags override. Load into a shell with:
#   set -a; source .env; set +a

# FHIR terminology server (Ontoserver) base URL: the IG Publisher's -tx server
# in _genonce.sh, and the default terminology server of
# scripts/merged_profile_provisioning/provision.py.
ONTOSERVER_URL=https://ontoserver.example.org/fhir

# Pathling server base URL, the default for
# scripts/merged_profile_provisioning/provision.py --pathling-url.
PATHLING_URL=https://pathling.example.org/fhir/

# Pathling Delta warehouse holding the full MIMIC-on-FHIR data (HPC node only)
MIMIC_WAREHOUSE=/path/to/spark_warehouse
